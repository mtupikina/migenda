{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @migenda/shared build && pnpm --filter @migenda/web build",
  "outputDirectory": "dist",
  "ignoreCommand": "exit 0",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://migenda-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
